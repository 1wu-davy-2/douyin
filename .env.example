# 帧藏(douyin-archive)环境变量样例 —— 复制为 .env 后按需修改。

# ===== 火花引擎(可选,`docker compose --profile spark up -d` 时必填) =====
# 引擎与 Go 后端共享的鉴权 token,两边必须一致;留空则 spark 功能整体禁用。
DY_SPARK_TOKEN=

# 引擎地址(compose 内服务名解析;本机裸跑引擎时 Go 侧默认 http://127.0.0.1:18788)
# DY_SPARK_URL=http://spark-engine:18788

# ===== 下载根目录(宿主机路径,映射进容器 /app/data/downloads) =====
# DOWNLOAD_ROOT=/opt/douyin/down
