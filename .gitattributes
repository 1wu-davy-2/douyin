# 统一行尾:Linux 侧执行的脚本/配置必须是 LF
*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf

# Windows 侧脚本保持 CRLF
*.ps1   text eol=crlf

# 二进制
*.mp4   binary
*.png   binary
*.jpg   binary
